# Copy this file to ./.env on the server, then replace every replace-with-*
# value. This file is a template and must not contain real secrets.

COMPOSE_PROJECT_NAME=ranqizao

NODE_ENV=production

# API
API_HOST=0.0.0.0
API_PORT=3001
# The web console is same-origin through /api. Add the mobile app or other
# browser origins here when they call the API directly.
CORS_ORIGINS=https://ops.example.com
JWT_SECRET=replace-with-a-long-random-jwt-secret
OPS_JWT_SECRET=replace-with-a-different-long-random-ops-secret

# Operations console administrator
OPS_ADMIN_USERNAME=replace-with-ops-admin-username
OPS_ADMIN_PASSWORD=replace-with-a-strong-ops-admin-password
OPS_ADMIN_DISPLAY_NAME=Operations Administrator

# Backend -> PostgreSQL. Compose uses these same values to initialize the
# PostgreSQL container, so there is only one database password to maintain.
PGHOST=postgres
PGPORT=5432
PGUSER=postgres
PGPASSWORD=replace-with-a-strong-postgres-password
PGDATABASE=ai_iot_safety_stove_control
PGADMIN_DATABASE=postgres

# WeChat login
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Google login
GOOGLE_APP_WEB_CLIENT_ID=

# Huawei Cloud IoTDA
HUAWEI_IOTDA_ENABLED=false
HUAWEI_IOTDA_ENDPOINT=https://replace-with-your-iotda-endpoint
HUAWEI_IOTDA_REGION=cn-north-4
HUAWEI_IOTDA_INSTANCE_ID=
HUAWEI_IOTDA_RESOURCE_SPACE_ID=
HUAWEI_IOTDA_SERVICE_ID=GasStoveBasic
HUAWEI_IOTDA_SIGNING_SERVICE=iotda
HUAWEI_IOTDA_RUNTIME_CACHE_TTL_MS=15000
HUAWEI_IOTDA_COMMAND_TIMEOUT_MS=8000
HUAWEI_IOTDA_CALLBACK_SECRET=
HUAWEI_CLOUD_AK=
HUAWEI_CLOUD_SK=
HUAWEI_CLOUD_PROJECT_ID=

# Aliyun SMS
ALIYUN_SMS_ENABLED=false
ALIYUN_SMS_ENDPOINT=https://dysmsapi.aliyuncs.com/
ALIYUN_SMS_REGION_ID=cn-hangzhou
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
SMS_TEMPLATE_PARAM_NAME=number
