# 复制到后端项目根目录 .env.production，并只在服务器填写真实值。
NODE_ENV=production

# API 与鉴权
API_HOST=0.0.0.0
API_PORT=3001
CORS_ORIGINS=https://ops.example.com
JWT_SECRET=replace-with-a-long-random-user-jwt-secret
OPS_JWT_SECRET=replace-with-a-different-long-random-ops-jwt-secret

# 运维中台管理员
OPS_ADMIN_USERNAME=admin
OPS_ADMIN_PASSWORD=replace-with-a-strong-ops-admin-password
OPS_ADMIN_DISPLAY_NAME=运维管理员

# PostgreSQL。Compose 会让后端使用 postgres 服务名，不要改成 127.0.0.1。
PGHOST=postgres
PGPORT=5432
PGUSER=postgres
PGPASSWORD=replace-with-a-strong-postgres-password
PGDATABASE=ai_iot_safety_stove_control
PGADMIN_DATABASE=postgres

# 微信登录
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Google 登录
GOOGLE_APP_WEB_CLIENT_ID=

# 华为云 IoTDA
HUAWEI_IOTDA_ENABLED=false
HUAWEI_IOTDA_ENDPOINT=
HUAWEI_IOTDA_REGION=cn-north-4
HUAWEI_IOTDA_INSTANCE_ID=
HUAWEI_IOTDA_RESOURCE_SPACE_ID=
HUAWEI_IOTDA_SERVICE_ID=GasStoveBasic
HUAWEI_IOTDA_SIGNING_SERVICE=iotda
HUAWEI_IOTDA_RUNTIME_CACHE_TTL_MS=15000
HUAWEI_IOTDA_COMMAND_TIMEOUT_MS=8000
HUAWEI_IOTDA_CALLBACK_SECRET=
HUAWEI_CLOUD_AK=
HUAWEI_CLOUD_SK=
HUAWEI_CLOUD_PROJECT_ID=

# 阿里云短信
ALIYUN_SMS_ENABLED=false
ALIYUN_SMS_ENDPOINT=https://dysmsapi.aliyuncs.com/
ALIYUN_SMS_REGION_ID=cn-hangzhou
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
SMS_TEMPLATE_PARAM_NAME=number
